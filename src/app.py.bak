"""
app.py
â”€â”€â”€â”€â”€â”€
Flask web dashboard for the EmoSense AI â€” Real-Time Facial Emotion Detection.

Routes
------
  GET  /                  â†’ Serve the dashboard HTML
  GET  /video_feed        â†’ MJPEG stream from webcam with CV annotations
  GET  /emotion_data      â†’ JSON: latest emotion probabilities + stats
  POST /control           â†’ Start / stop / screenshot controls
  GET  /history           â†’ JSON: last N emotion readings for the chart

Usage
-----
  cd "AI project"
  .venv\\Scripts\\python.exe src/app.py

Then open http://localhost:5000 in your browser.
"""

import os
import sys
import json
import time
import threading
import base64
from collections import deque
from datetime import datetime

import cv2
import numpy as np
from flask import Flask, Response, render_template, jsonify, request

# â”€â”€ Path setup â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
PROJECT_ROOT    = os.path.join(os.path.dirname(__file__), '..')
TEMPLATES_DIR   = os.path.join(PROJECT_ROOT, 'templates')
STATIC_DIR      = os.path.join(PROJECT_ROOT, 'static')
MODEL_PATH      = os.path.join(PROJECT_ROOT, 'models', 'emotion_model.h5')
LABEL_MAP_PATH  = os.path.join(PROJECT_ROOT, 'models', 'label_map.json')
CASCADE_PATH    = os.path.join(PROJECT_ROOT, 'haarcascades',
                                'haarcascade_frontalface_default.xml')
SCREENSHOTS_DIR = os.path.join(PROJECT_ROOT, 'screenshots')
os.makedirs(SCREENSHOTS_DIR, exist_ok=True)

sys.path.insert(0, os.path.dirname(__file__))

app = Flask(__name__,
            template_folder=TEMPLATES_DIR,
            static_folder=STATIC_DIR)

# â”€â”€ Emotion Config â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
EMOTION_LABELS = ['Angry', 'Fear', 'Happy', 'Neutral', 'Sad', 'Surprise']
EMOTION_COLORS_HEX = {
    'Angry':    '#ef4444',
    'Fear':     '#a855f7',
    'Happy':    '#22c55e',
    'Neutral':  '#94a3b8',
    'Sad':      '#3b82f6',
    'Surprise': '#f97316',
}

# â”€â”€ Shared State (thread-safe via lock) â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
state_lock = threading.Lock()
state = {
    'running':        False,
    'frame_jpg':      None,
    'fps':            0.0,
    'face_count':     0,
    'emotion_probs':  {e: 0.0 for e in EMOTION_LABELS},
    'top_emotion':    'Neutral',
    'confidence':     0.0,
    'total_frames':   0,
    'session_start':  None,
    'emotion_counts': {e: 0 for e in EMOTION_LABELS},
}

# â”€â”€ Emotion history ring buffer â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
HISTORY_SIZE = 60
history = deque(maxlen=HISTORY_SIZE)

# â”€â”€ Global model / cascade â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
keras_model   = None
face_cascade  = None
camera_thread = None


# â”€â”€ Loaders â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€

def load_resources():
    """Load Keras model and Haar Cascade â€” called once at startup."""
    global keras_model, face_cascade, EMOTION_LABELS

    import tensorflow as tf
    print("[INFO] Loading modelâ€¦")
    keras_model = tf.keras.models.load_model(MODEL_PATH)
    print("[INFO] Model loaded.")

    if os.path.isfile(LABEL_MAP_PATH):
        with open(LABEL_MAP_PATH) as f:
            lm = json.load(f)
        EMOTION_LABELS[:] = [None] * len(lm)
        for name, idx in lm.items():
            EMOTION_LABELS[idx] = name.capitalize()
        print(f"[INFO] Labels: {EMOTION_LABELS}")

    if os.path.isfile(CASCADE_PATH):
        face_cascade = cv2.CascadeClassifier(CASCADE_PATH)
    else:
        builtin = cv2.data.haarcascades + 'haarcascade_frontalface_default.xml'
        face_cascade = cv2.CascadeClassifier(builtin)
    print("[INFO] Cascade loaded.")


# â”€â”€ Camera Worker Thread â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€

def camera_worker(camera_index: int = 0):
    """Background thread: reads webcam, runs inference, pushes JPEG to state."""
    cap = cv2.VideoCapture(camera_index)
    if not cap.isOpened():
        print(f"[ERROR] Cannot open camera {camera_index}")
        with state_lock:
            state['running'] = False
        return

    with state_lock:
        state['session_start'] = datetime.now()

    prev_time        = time.time()
    history_counter  = 0

    while True:
        with state_lock:
            if not state['running']:
                break

        ret, frame = cap.read()
        if not ret:
            break

        curr_time = time.time()
        fps = 1.0 / max(curr_time - prev_time, 1e-9)
        prev_time = curr_time
        history_counter += 1

        gray    = cv2.cvtColor(frame, cv2.COLOR_BGR2GRAY)
        gray_eq = cv2.equalizeHist(gray)

        raw_faces = face_cascade.detectMultiScale(
            gray_eq, scaleFactor=1.3, minNeighbors=5,
            minSize=(30, 30), flags=cv2.CASCADE_SCALE_IMAGE
        )
        faces = raw_faces if len(raw_faces) > 0 else []

        top_emotion = 'Neutral'
        confidence  = 0.0
        all_probs   = {e: 0.0 for e in EMOTION_LABELS}

        for (x, y, w, h) in faces:
            try:
                face_roi     = gray[y:y+h, x:x+w]
                face_resized = cv2.resize(face_roi, (48, 48))
                face_norm    = face_resized.astype(np.float32) / 255.0
                face_input   = face_norm.reshape(1, 48, 48, 1)

                preds        = keras_model.predict(face_input, verbose=0)[0]
                idx          = int(np.argmax(preds))
                top_emotion  = EMOTION_LABELS[idx]
                confidence   = float(preds[idx])
                all_probs    = {
                    EMOTION_LABELS[i]: float(preds[i])
                    for i in range(len(EMOTION_LABELS))
                }

                # Cyan bounding box
                cv2.rectangle(frame, (x, y), (x+w, y+h), (0, 220, 220), 2)
                label = f"{top_emotion}  {confidence*100:.0f}%"
                (tw, th), _ = cv2.getTextSize(label, cv2.FONT_HERSHEY_DUPLEX, 0.65, 1)
                ly = y - 8 if y - 8 > 8 else y + h + 20
                cv2.rectangle(frame, (x, ly - th - 6), (x + tw + 8, ly + 4),
                              (10, 10, 30), -1)
                cv2.putText(frame, label, (x + 4, ly - 2),
                            cv2.FONT_HERSHEY_DUPLEX, 0.65, (0, 220, 220), 1,
                            cv2.LINE_AA)
            except Exception as e:
                print(f"[WARN] Face proc error: {e}")

        # HUD overlay
        cv2.putText(frame, f"FPS {fps:.0f}", (10, 24),
                    cv2.FONT_HERSHEY_DUPLEX, 0.6, (0, 220, 220), 1, cv2.LINE_AA)
        cv2.putText(frame, f"Faces {len(faces)}", (10, 48),
                    cv2.FONT_HERSHEY_DUPLEX, 0.6, (0, 220, 220), 1, cv2.LINE_AA)

        _, jpg = cv2.imencode('.jpg', frame, [cv2.IMWRITE_JPEG_QUALITY, 80])
        jpg_bytes = jpg.tobytes()

        with state_lock:
            state['frame_jpg']     = jpg_bytes
            state['fps']           = round(fps, 1)
            state['face_count']    = len(faces)
            state['emotion_probs'] = all_probs
            state['top_emotion']   = top_emotion
            state['confidence']    = confidence
            state['total_frames'] += 1
            if faces:
                state['emotion_counts'][top_emotion] += 1

        # Push history every ~15 frames
        if history_counter >= 15:
            history_counter = 0
            entry = {'ts': datetime.now().strftime('%H:%M:%S')}
            entry.update(all_probs)
            history.append(entry)

    cap.release()
    with state_lock:
        state['running'] = False
    print("[INFO] Camera worker stopped.")


# â”€â”€ Flask Routes â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€

@app.route('/')
def index():
    return render_template('index.html',
                           emotions=EMOTION_LABELS,
                           colors=EMOTION_COLORS_HEX)


def gen_frames():
    """MJPEG generator â€” yields frames from shared state."""
    blank = np.zeros((480, 640, 3), dtype=np.uint8)
    cv2.putText(blank, 'Click  Start  to begin', (120, 240),
                cv2.FONT_HERSHEY_DUPLEX, 0.9, (60, 60, 80), 1, cv2.LINE_AA)
    _, blank_jpg  = cv2.imencode('.jpg', blank)
    blank_bytes   = blank_jpg.tobytes()

    while True:
        with state_lock:
            running  = state['running']
            jpg_data = state['frame_jpg']

        frame_data = jpg_data if (running and jpg_data) else blank_bytes

        yield (b'--frame\r\n'
               b'Content-Type: image/jpeg\r\n\r\n' + frame_data + b'\r\n')
        time.sleep(0.033)


@app.route('/video_feed')
def video_feed():
    return Response(gen_frames(),
                    mimetype='multipart/x-mixed-replace; boundary=frame')


@app.route('/emotion_data')
def emotion_data():
    with state_lock:
        data = {
            'running':        state['running'],
            'fps':            state['fps'],
            'face_count':     state['face_count'],
            'emotion_probs':  state['emotion_probs'],
            'top_emotion':    state['top_emotion'],
            'confidence':     round(state['confidence'] * 100, 1),
            'total_frames':   state['total_frames'],
            'emotion_counts': state['emotion_counts'],
            'session_duration': (
                str(datetime.now() - state['session_start']).split('.')[0]
                if state['session_start'] else '00:00:00'
            ),
        }
    return jsonify(data)


@app.route('/history')
def get_history():
    return jsonify(list(history))


@app.route('/control', methods=['POST'])
def control():
    global camera_thread
    payload = request.json or {}
    action  = payload.get('action', '')

    if action == 'start':
        cam_idx = int(payload.get('camera', 0))
        with state_lock:
            if not state['running']:
                state['running']        = True
                state['total_frames']   = 0
                state['emotion_counts'] = {e: 0 for e in EMOTION_LABELS}
                state['session_start']  = None
                state['frame_jpg']      = None
                state['emotion_probs']  = {e: 0.0 for e in EMOTION_LABELS}
        history.clear()
        camera_thread = threading.Thread(
            target=camera_worker, args=(cam_idx,), daemon=True)
        camera_thread.start()
        return jsonify({'status': 'started'})

    elif action == 'stop':
        with state_lock:
            state['running'] = False
        return jsonify({'status': 'stopped'})

    elif action == 'screenshot':
        with state_lock:
            jpg = state['frame_jpg']
        if jpg:
            ts       = datetime.now().strftime('%Y%m%d_%H%M%S')
            filename = os.path.join(SCREENSHOTS_DIR, f'snap_{ts}.jpg')
            with open(filename, 'wb') as f:
                f.write(jpg)
            return jsonify({'status': 'saved', 'file': os.path.basename(filename)})
        return jsonify({'status': 'no_frame'})

    return jsonify({'status': 'unknown_action'})


# â”€â”€ Entry Point â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
if __name__ == '__main__':
    load_resources()
    print('\n[INFO] EmoSense AI Dashboard â†’ http://localhost:5000\n')
    app.run(host='0.0.0.0', port=5000, debug=False, threaded=True)

