<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>EmoSense AI â€” Real-Time Emotion Detection</title>
  <meta name="description" content="Real-time facial emotion detection powered by a CNN trained on FER-2013. Detects Angry, Fear, Happy, Neutral, Sad and Surprise." />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&family=Space+Grotesk:wght@400;500;600;700&display=swap" rel="stylesheet" />

  <style>
    /* â”€â”€ Reset & Base â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€ */
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    :root {
      --bg:          #070714;
      --bg2:         #0d0d22;
      --bg3:         #12122e;
      --glass:       rgba(255,255,255,0.04);
      --border:      rgba(255,255,255,0.08);
      --cyan:        #00e5ff;
      --cyan-dim:    rgba(0,229,255,0.12);
      --text:        #e2e8f0;
      --text-dim:    #64748b;
      --green:       #22c55e;
      --red:         #ef4444;
      --purple:      #a855f7;
      --blue:        #3b82f6;
      --orange:      #f97316;
      --grey:        #94a3b8;
      --radius:      14px;
      --glow-cyan:   0 0 24px rgba(0,229,255,0.3);
    }

    html { font-size: 15px; scroll-behavior: smooth; }

    body {
      background: var(--bg);
      color: var(--text);
      font-family: 'Inter', sans-serif;
      min-height: 100vh;
      overflow-x: hidden;
      background-image:
        radial-gradient(ellipse 80% 50% at 50% -20%, rgba(0,100,200,0.12) 0%, transparent 60%),
        radial-gradient(ellipse 60% 40% at 80% 100%, rgba(120,0,200,0.08) 0%, transparent 50%);
    }

    /* â”€â”€ Header â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€ */
    header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 18px 32px;
      border-bottom: 1px solid var(--border);
      background: rgba(7,7,20,0.85);
      backdrop-filter: blur(16px);
      position: sticky;
      top: 0;
      z-index: 100;
    }

    .logo {
      display: flex;
      align-items: center;
      gap: 12px;
      text-decoration: none;
    }
    .logo-icon {
      width: 42px; height: 42px;
      background: linear-gradient(135deg, var(--cyan), #7c3aed);
      border-radius: 10px;
      display: grid; place-items: center;
      font-size: 22px;
      box-shadow: var(--glow-cyan);
      flex-shrink: 0;
    }
    .logo-text h1 {
      font-family: 'Space Grotesk', sans-serif;
      font-size: 1.3rem;
      font-weight: 700;
      background: linear-gradient(90deg, var(--cyan), #a78bfa);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      background-clip: text;
    }
    .logo-text p { font-size: 0.75rem; color: var(--text-dim); margin-top: 1px; }

    .header-stats {
      display: flex; gap: 20px;
    }
    .hstat {
      text-align: center;
      padding: 6px 16px;
      background: var(--glass);
      border: 1px solid var(--border);
      border-radius: 30px;
    }
    .hstat-value {
      font-size: 1.1rem; font-weight: 700;
      color: var(--cyan);
      font-family: 'Space Grotesk', sans-serif;
    }
    .hstat-label { font-size: 0.68rem; color: var(--text-dim); }

    /* â”€â”€ Main Layout â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€ */
    main {
      display: grid;
      grid-template-columns: 1fr 380px;
      grid-template-rows: auto auto;
      gap: 20px;
      padding: 24px 32px;
      max-width: 1440px;
      margin: 0 auto;
    }

    /* â”€â”€ Cards â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€ */
    .card {
      background: var(--glass);
      border: 1px solid var(--border);
      border-radius: var(--radius);
      backdrop-filter: blur(12px);
      overflow: hidden;
    }
    .card-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 14px 18px;
      border-bottom: 1px solid var(--border);
    }
    .card-title {
      font-size: 0.8rem; font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 0.08em;
      color: var(--text-dim);
    }
    .card-body { padding: 18px; }

    /* â”€â”€ Status Dot â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€ */
    .status-dot {
      width: 8px; height: 8px;
      border-radius: 50%;
      background: #334155;
      transition: background 0.3s;
    }
    .status-dot.live {
      background: var(--green);
      box-shadow: 0 0 8px var(--green);
      animation: pulse-dot 1.5s infinite;
    }
    @keyframes pulse-dot {
      0%,100% { opacity: 1; }
      50%      { opacity: 0.4; }
    }

    /* â”€â”€ Webcam Feed â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€ */
    #cam-card {
      grid-column: 1;
      grid-row: 1;
    }
    .feed-wrapper {
      position: relative;
      background: #05050f;
      aspect-ratio: 4/3;
      display: flex;
      align-items: center;
      justify-content: center;
      overflow: hidden;
    }
    #feed-img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      display: block;
      transition: filter 0.3s;
    }
    #feed-img.offline { filter: brightness(0.3) grayscale(1); }

    .feed-overlay {
      position: absolute;
      inset: 0;
      pointer-events: none;
      border: 2px solid transparent;
      border-radius: 0;
      transition: border-color 0.5s;
    }
    .feed-overlay.live { border-color: rgba(0,229,255,0.3); }

    /* Corner brackets */
    .feed-corner {
      position: absolute;
      width: 20px; height: 20px;
      border-color: var(--cyan);
      border-style: solid;
      opacity: 0;
      transition: opacity 0.4s;
    }
    .feed-wrapper.live .feed-corner { opacity: 1; }
    .feed-corner.tl { top: 10px; left: 10px;  border-width: 2px 0 0 2px; }
    .feed-corner.tr { top: 10px; right: 10px; border-width: 2px 2px 0 0; }
    .feed-corner.bl { bottom:10px; left: 10px;  border-width: 0 0 2px 2px; }
    .feed-corner.br { bottom:10px; right: 10px; border-width: 0 2px 2px 0; }

    .offline-msg {
      position: absolute;
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 10px;
      color: var(--text-dim);
      font-size: 0.9rem;
    }
    .offline-msg .icon { font-size: 2.5rem; opacity: 0.4; }
    body.running .offline-msg { display: none; }

    /* â”€â”€ Controls â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€ */
    .controls {
      display: flex;
      align-items: center;
      gap: 10px;
      flex-wrap: wrap;
    }
    .btn {
      padding: 8px 20px;
      border-radius: 8px;
      border: none;
      font-family: 'Inter', sans-serif;
      font-size: 0.82rem;
      font-weight: 600;
      cursor: pointer;
      transition: all 0.2s;
      display: flex;
      align-items: center;
      gap: 6px;
    }
    .btn:active { transform: scale(0.96); }

    #btn-start {
      background: linear-gradient(135deg, #06b6d4, #7c3aed);
      color: #fff;
      box-shadow: 0 0 20px rgba(6,182,212,0.4);
    }
    #btn-start:hover { box-shadow: 0 0 30px rgba(6,182,212,0.6); transform: translateY(-1px); }

    #btn-stop {
      background: rgba(239,68,68,0.15);
      border: 1px solid rgba(239,68,68,0.4);
      color: var(--red);
    }
    #btn-stop:hover { background: rgba(239,68,68,0.25); }

    #btn-snap {
      background: var(--glass);
      border: 1px solid var(--border);
      color: var(--text);
    }
    #btn-snap:hover { background: rgba(255,255,255,0.08); }

    .cam-select {
      padding: 7px 12px;
      border-radius: 8px;
      background: var(--bg3);
      border: 1px solid var(--border);
      color: var(--text);
      font-size: 0.8rem;
      cursor: pointer;
    }

    .snap-toast {
      position: fixed;
      bottom: 30px;
      right: 30px;
      background: rgba(34,197,94,0.15);
      border: 1px solid rgba(34,197,94,0.4);
      color: var(--green);
      padding: 10px 20px;
      border-radius: 10px;
      font-size: 0.82rem;
      font-weight: 600;
      opacity: 0;
      transform: translateY(10px);
      transition: all 0.3s;
      z-index: 999;
      pointer-events: none;
    }
    .snap-toast.show { opacity: 1; transform: translateY(0); }

    /* â”€â”€ Emotion Bars â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€ */
    #emo-card {
      grid-column: 2;
      grid-row: 1;
    }
    .emotion-dominant {
      text-align: center;
      padding: 18px 0 12px;
    }
    .emotion-emoji {
      font-size: 3.2rem;
      line-height: 1;
      display: block;
      filter: drop-shadow(0 0 12px rgba(255,255,255,0.3));
      transition: all 0.4s ease;
    }
    .emotion-name {
      font-family: 'Space Grotesk', sans-serif;
      font-size: 1.5rem;
      font-weight: 700;
      margin-top: 8px;
      transition: color 0.4s;
    }
    .emotion-conf {
      font-size: 0.78rem;
      color: var(--text-dim);
      margin-top: 3px;
    }

    .emo-bars { display: flex; flex-direction: column; gap: 11px; margin-top: 8px; }

    .emo-row { }
    .emo-row-header {
      display: flex;
      justify-content: space-between;
      margin-bottom: 4px;
    }
    .emo-label {
      font-size: 0.75rem; font-weight: 600;
      display: flex; align-items: center; gap: 6px;
    }
    .emo-dot {
      width: 8px; height: 8px;
      border-radius: 50%;
      flex-shrink: 0;
    }
    .emo-pct {
      font-size: 0.75rem; font-weight: 700;
      font-family: 'Space Grotesk', sans-serif;
    }
    .emo-bar-track {
      height: 8px;
      background: rgba(255,255,255,0.05);
      border-radius: 99px;
      overflow: hidden;
    }
    .emo-bar-fill {
      height: 100%;
      border-radius: 99px;
      width: 0%;
      transition: width 0.5s cubic-bezier(0.34,1.56,0.64,1);
    }

    /* â”€â”€ History Chart â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€ */
    #chart-card {
      grid-column: 1 / -1;
      grid-row: 2;
    }
    #emotion-chart {
      width: 100%;
      height: 180px;
      display: block;
    }

    /* â”€â”€ Stats Row â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€ */
    #stats-card {
      grid-column: 1 / -1;
      grid-row: 3;
    }
    .stats-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(130px, 1fr));
      gap: 12px;
    }
    .stat-box {
      background: var(--bg3);
      border: 1px solid var(--border);
      border-radius: 10px;
      padding: 14px 16px;
      text-align: center;
    }
    .stat-val {
      font-family: 'Space Grotesk', sans-serif;
      font-size: 1.4rem;
      font-weight: 700;
      color: var(--cyan);
    }
    .stat-lbl { font-size: 0.7rem; color: var(--text-dim); margin-top: 2px; }

    /* â”€â”€ Emotion Count Bars â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€ */
    .count-bars {
      display: flex;
      flex-direction: column;
      gap: 6px;
      margin-top: 4px;
    }
    .count-row {
      display: flex;
      align-items: center;
      gap: 10px;
      font-size: 0.72rem;
    }
    .count-label { width: 58px; color: var(--text-dim); text-align: right; }
    .count-track { flex: 1; height: 5px; background: rgba(255,255,255,0.06); border-radius: 99px; overflow: hidden; }
    .count-fill  { height: 100%; border-radius: 99px; transition: width 0.6s ease; }
    .count-num   { width: 32px; color: var(--text-dim); text-align: right; }

    /* â”€â”€ Scanning animation on feed â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€ */
    .scan-line {
      position: absolute;
      left: 0; right: 0;
      height: 2px;
      background: linear-gradient(90deg, transparent, var(--cyan), transparent);
      animation: scan 2.5s linear infinite;
      pointer-events: none;
      opacity: 0;
      transition: opacity 0.4s;
    }
    .feed-wrapper.live .scan-line { opacity: 0.6; }
    @keyframes scan {
      0%   { top: 0%; }
      100% { top: 100%; }
    }

    /* â”€â”€ Responsive â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€ */
    @media (max-width: 900px) {
      main { grid-template-columns: 1fr; }
      #emo-card { grid-column: 1; grid-row: 2; }
      #cam-card { grid-column: 1; grid-row: 1; }
      #chart-card { grid-row: 3; }
      #stats-card { grid-row: 4; }
    }
    @media (max-width: 540px) {
      header { padding: 12px 16px; }
      main   { padding: 14px 12px; gap: 12px; }
      .header-stats { display: none; }
    }
  </style>
</head>
<body>

<!-- â”€â”€ Header â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€ -->
<header>
  <a class="logo" href="/">
    <div class="logo-icon">ðŸ§ </div>
    <div class="logo-text">
      <h1>EmoSense AI</h1>
      <p>Real-Time Emotion Detection â€¢ CNN + FER-2013</p>
    </div>
  </a>
  <div class="header-stats">
    <div class="hstat">
      <div class="hstat-value" id="hdr-fps">â€”</div>
      <div class="hstat-label">FPS</div>
    </div>
    <div class="hstat">
      <div class="hstat-value" id="hdr-faces">0</div>
      <div class="hstat-label">Faces</div>
    </div>
    <div class="hstat">
      <div class="hstat-value" id="hdr-conf">â€”</div>
      <div class="hstat-label">Confidence</div>
    </div>
  </div>
</header>

<!-- â”€â”€ Main â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€ -->
<main>

  <!-- Webcam Feed Card -->
  <div class="card" id="cam-card">
    <div class="card-header">
      <span class="card-title">ðŸ“· Live Webcam Feed</span>
      <div style="display:flex;align-items:center;gap:8px;">
        <div class="status-dot" id="status-dot"></div>
        <span style="font-size:0.72rem;color:var(--text-dim)" id="status-label">Offline</span>
      </div>
    </div>

    <div class="feed-wrapper" id="feed-wrapper">
      <img id="feed-img" src="/video_feed" alt="Webcam feed" class="offline" />
      <div class="feed-overlay" id="feed-overlay"></div>
      <div class="feed-corner tl"></div>
      <div class="feed-corner tr"></div>
      <div class="feed-corner bl"></div>
      <div class="feed-corner br"></div>
      <div class="scan-line"></div>
      <div class="offline-msg" id="offline-msg">
        <span class="icon">ðŸ“·</span>
        <span>Click <strong>Start Camera</strong> to begin</span>
      </div>
    </div>

    <div class="card-body" style="padding:14px 18px;">
      <div class="controls">
        <select class="cam-select" id="cam-select" title="Camera Index">
          <option value="0">Camera 0 (built-in)</option>
          <option value="1">Camera 1 (external)</option>
          <option value="2">Camera 2</option>
        </select>
        <button class="btn" id="btn-start">â–¶ Start Camera</button>
        <button class="btn" id="btn-stop">â¹ Stop</button>
        <button class="btn" id="btn-snap">ðŸ“¸ Snapshot</button>
      </div>
    </div>
  </div>

  <!-- Emotion Bars Card -->
  <div class="card" id="emo-card">
    <div class="card-header">
      <span class="card-title">ðŸ˜Š Emotion Scores</span>
      <span style="font-size:0.7rem;color:var(--text-dim)">Live probabilities</span>
    </div>
    <div class="card-body">
      <div class="emotion-dominant">
        <span class="emotion-emoji" id="dominant-emoji">ðŸ˜</span>
        <div class="emotion-name" id="dominant-name" style="color:var(--grey)">Neutral</div>
        <div class="emotion-conf" id="dominant-conf">Waiting for faceâ€¦</div>
      </div>

      <div class="emo-bars" id="emo-bars">
        <!-- injected by JS from template data -->
      </div>
    </div>
  </div>

  <!-- History Chart Card -->
  <div class="card" id="chart-card">
    <div class="card-header">
      <span class="card-title">ðŸ“ˆ Emotion Timeline</span>
      <span style="font-size:0.7rem;color:var(--text-dim)" id="chart-range">Last 60 readings</span>
    </div>
    <div class="card-body" style="padding:10px 14px;">
      <canvas id="emotion-chart"></canvas>
    </div>
  </div>

  <!-- Session Stats Card -->
  <div class="card" id="stats-card">
    <div class="card-header">
      <span class="card-title">ðŸ“Š Session Statistics</span>
      <span style="font-size:0.7rem;color:var(--text-dim)" id="session-dur">00:00:00</span>
    </div>
    <div class="card-body">
      <div style="display:grid;grid-template-columns:1fr 1fr;gap:20px;">
        <div>
          <div class="stats-grid" id="stats-grid">
            <div class="stat-box">
              <div class="stat-val" id="st-frames">0</div>
              <div class="stat-lbl">Frames Analysed</div>
            </div>
            <div class="stat-box">
              <div class="stat-val" id="st-fps">â€”</div>
              <div class="stat-lbl">Avg FPS</div>
            </div>
            <div class="stat-box">
              <div class="stat-val" id="st-faces">0</div>
              <div class="stat-lbl">Faces Now</div>
            </div>
            <div class="stat-box">
              <div class="stat-val" id="st-conf">â€”</div>
              <div class="stat-lbl">Confidence</div>
            </div>
          </div>
        </div>
        <div>
          <div style="font-size:0.72rem;color:var(--text-dim);margin-bottom:8px;text-transform:uppercase;letter-spacing:0.06em;">Emotion Distribution</div>
          <div class="count-bars" id="count-bars"></div>
        </div>
      </div>
    </div>
  </div>

</main>

<!-- Toast -->
<div class="snap-toast" id="snap-toast">ðŸ“¸ Screenshot saved!</div>

<!-- â”€â”€ Scripts â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€ -->
<script>
/* â”€â”€ Config passed from Flask â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€ */
const EMOTIONS = {{ emotions | tojson }};
const COLORS   = {{ colors | tojson }};

const EMOJIS = {
  Angry: 'ðŸ˜ ', Fear: 'ðŸ˜¨', Happy: 'ðŸ˜',
  Neutral: 'ðŸ˜', Sad: 'ðŸ˜¢', Surprise: 'ðŸ˜²'
};

/* â”€â”€ Build emotion bars HTML â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€ */
function buildBars() {
  const container = document.getElementById('emo-bars');
  container.innerHTML = EMOTIONS.map(emo => `
    <div class="emo-row" id="row-${emo}">
      <div class="emo-row-header">
        <span class="emo-label">
          <span class="emo-dot" style="background:${COLORS[emo]}"></span>
          ${EMOJIS[emo] || ''} ${emo}
        </span>
        <span class="emo-pct" id="pct-${emo}" style="color:${COLORS[emo]}">0%</span>
      </div>
      <div class="emo-bar-track">
        <div class="emo-bar-fill" id="bar-${emo}"
             style="background:linear-gradient(90deg,${COLORS[emo]}aa,${COLORS[emo]});width:0%"></div>
      </div>
    </div>
  `).join('');
}

/* â”€â”€ Build count bars â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€ */
function buildCountBars() {
  const container = document.getElementById('count-bars');
  container.innerHTML = EMOTIONS.map(emo => `
    <div class="count-row">
      <span class="count-label">${emo}</span>
      <div class="count-track">
        <div class="count-fill" id="cnt-${emo}" style="background:${COLORS[emo]};width:0%"></div>
      </div>
      <span class="count-num" id="cntv-${emo}">0</span>
    </div>
  `).join('');
}

/* â”€â”€ Canvas Chart â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€ */
const canvas = document.getElementById('emotion-chart');
const ctx    = canvas.getContext('2d');
let chartData = [];

function resizeCanvas() {
  canvas.width  = canvas.offsetWidth * devicePixelRatio;
  canvas.height = canvas.offsetHeight * devicePixelRatio;
  ctx.scale(devicePixelRatio, devicePixelRatio);
  drawChart();
}

function drawChart() {
  const W = canvas.offsetWidth;
  const H = canvas.offsetHeight;
  ctx.clearRect(0, 0, W, H);

  if (chartData.length < 2) {
    ctx.fillStyle = 'rgba(255,255,255,0.06)';
    ctx.font = '13px Inter';
    ctx.textAlign = 'center';
    ctx.fillText('Emotion history will appear hereâ€¦', W/2, H/2);
    return;
  }

  const N    = chartData.length;
  const padL = 8, padR = 8, padT = 10, padB = 18;
  const plotW = W - padL - padR;
  const plotH = H - padT - padB;

  // Grid lines
  ctx.strokeStyle = 'rgba(255,255,255,0.04)';
  ctx.lineWidth = 1;
  for (let i = 0; i <= 4; i++) {
    const y = padT + (plotH * i) / 4;
    ctx.beginPath(); ctx.moveTo(padL, y); ctx.lineTo(W - padR, y); ctx.stroke();
  }

  // Lines per emotion
  EMOTIONS.forEach(emo => {
    const color = COLORS[emo];
    ctx.beginPath();
    ctx.strokeStyle = color;
    ctx.lineWidth = 2;
    ctx.lineJoin  = 'round';
    ctx.shadowBlur = 6;
    ctx.shadowColor = color;

    chartData.forEach((d, i) => {
      const x = padL + (i / (N - 1)) * plotW;
      const v = d[emo] ?? 0;
      const y = padT + plotH - v * plotH;
      i === 0 ? ctx.moveTo(x, y) : ctx.lineTo(x, y);
    });
    ctx.stroke();
    ctx.shadowBlur = 0;
  });

  // X labels (timestamps)
  ctx.fillStyle = 'rgba(255,255,255,0.2)';
  ctx.font = '10px Inter';
  ctx.textAlign = 'center';
  const step = Math.max(1, Math.floor(N / 6));
  for (let i = 0; i < N; i += step) {
    const x = padL + (i / (N - 1)) * plotW;
    ctx.fillText(chartData[i].ts || '', x, H - 3);
  }
}

/* â”€â”€ State variables â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€ */
let isRunning = false;

/* â”€â”€ DOM refs â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€ */
const feedImg     = document.getElementById('feed-img');
const feedWrapper = document.getElementById('feed-wrapper');
const feedOverlay = document.getElementById('feed-overlay');
const statusDot   = document.getElementById('status-dot');
const statusLabel = document.getElementById('status-label');
const offlineMsg  = document.getElementById('offline-msg');

const btnStart = document.getElementById('btn-start');
const btnStop  = document.getElementById('btn-stop');
const btnSnap  = document.getElementById('btn-snap');
const camSel   = document.getElementById('cam-select');

/* â”€â”€ UI State helpers â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€ */
function setLive(live) {
  isRunning = live;
  if (live) {
    statusDot.classList.add('live');
    statusLabel.textContent = 'Live';
    feedImg.classList.remove('offline');
    feedWrapper.classList.add('live');
    feedOverlay.classList.add('live');
    offlineMsg.style.display = 'none';
    document.body.classList.add('running');
  } else {
    statusDot.classList.remove('live');
    statusLabel.textContent = 'Offline';
    feedImg.classList.add('offline');
    feedWrapper.classList.remove('live');
    feedOverlay.classList.remove('live');
    offlineMsg.style.display = 'flex';
    document.body.classList.remove('running');
  }
}

/* â”€â”€ Controls â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€ */
btnStart.addEventListener('click', async () => {
  const cam = parseInt(camSel.value, 10);
  await fetch('/control', {
    method: 'POST',
    headers: {'Content-Type': 'application/json'},
    body: JSON.stringify({action: 'start', camera: cam})
  });
  setLive(true);
});

btnStop.addEventListener('click', async () => {
  await fetch('/control', {
    method: 'POST',
    headers: {'Content-Type': 'application/json'},
    body: JSON.stringify({action: 'stop'})
  });
  setLive(false);
});

btnSnap.addEventListener('click', async () => {
  const res  = await fetch('/control', {
    method: 'POST',
    headers: {'Content-Type': 'application/json'},
    body: JSON.stringify({action: 'screenshot'})
  });
  const data = await res.json();
  if (data.status === 'saved') {
    const toast = document.getElementById('snap-toast');
    toast.textContent = `ðŸ“¸ Saved: ${data.file}`;
    toast.classList.add('show');
    setTimeout(() => toast.classList.remove('show'), 3000);
  }
});

/* â”€â”€ Update emotion bars â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€ */
function updateBars(probs, topEmo, conf) {
  EMOTIONS.forEach(emo => {
    const p = (probs[emo] ?? 0) * 100;
    document.getElementById(`bar-${emo}`).style.width = `${p.toFixed(1)}%`;
    document.getElementById(`pct-${emo}`).textContent = `${p.toFixed(0)}%`;
  });

  // Dominant emotion display
  document.getElementById('dominant-emoji').textContent = EMOJIS[topEmo] || 'ðŸ˜';
  const nameEl = document.getElementById('dominant-name');
  nameEl.textContent = topEmo;
  nameEl.style.color = COLORS[topEmo] || 'var(--grey)';
  document.getElementById('dominant-conf').textContent =
    conf > 0 ? `${conf.toFixed(1)}% confidence` : 'Waiting for faceâ€¦';
}

/* â”€â”€ Update count distribution â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€ */
function updateCounts(counts) {
  const total = Object.values(counts).reduce((a,b) => a+b, 0) || 1;
  EMOTIONS.forEach(emo => {
    const n = counts[emo] || 0;
    const pct = (n / total * 100).toFixed(1);
    document.getElementById(`cnt-${emo}`).style.width  = `${pct}%`;
    document.getElementById(`cntv-${emo}`).textContent = n;
  });
}

/* â”€â”€ Poll loop â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€ */
let lastHistoryLen = 0;

async function poll() {
  try {
    const [emoRes, histRes] = await Promise.all([
      fetch('/emotion_data'),
      fetch('/history')
    ]);
    const emo  = await emoRes.json();
    const hist = await histRes.json();

    // Sync running state if server says otherwise
    if (isRunning !== emo.running) setLive(emo.running);

    // Header stats
    document.getElementById('hdr-fps').textContent   = emo.fps || 'â€”';
    document.getElementById('hdr-faces').textContent = emo.face_count;
    document.getElementById('hdr-conf').textContent  = emo.confidence > 0 ? `${emo.confidence}%` : 'â€”';

    // Bars
    updateBars(emo.emotion_probs, emo.top_emotion, emo.confidence);
    updateCounts(emo.emotion_counts);

    // Session stats
    document.getElementById('st-frames').textContent = emo.total_frames.toLocaleString();
    document.getElementById('st-fps').textContent    = emo.fps || 'â€”';
    document.getElementById('st-faces').textContent  = emo.face_count;
    document.getElementById('st-conf').textContent   = emo.confidence > 0 ? `${emo.confidence}%` : 'â€”';
    document.getElementById('session-dur').textContent = emo.session_duration || '00:00:00';

    // Chart
    if (hist.length !== lastHistoryLen) {
      lastHistoryLen = hist.length;
      chartData = hist;
      drawChart();
      document.getElementById('chart-range').textContent =
        `Last ${hist.length} readings`;
    }
  } catch (e) {
    console.warn('Poll error:', e);
  }
}

/* â”€â”€ Init â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€ */
buildBars();
buildCountBars();
resizeCanvas();

window.addEventListener('resize', resizeCanvas);
setInterval(poll, 500);

// Refresh feed src to avoid browser caching issues
document.getElementById('feed-img').src = '/video_feed?' + Date.now();
</script>

</body>
</html>

